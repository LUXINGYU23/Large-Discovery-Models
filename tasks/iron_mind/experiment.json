  "metrics": {
    "reported": [
      {
        "name": "reaction_score",
        "direction": "maximize",
        "description": "Official frozen-table score: raw yield/conversion, or the Chan-Lam lower-bound weighted selectivity score."
      }
    ],
    "optimized": [
      {
        "name": "reaction_score",
        "direction": "maximize",
        "description": "The sole factor-aware categorical ARD GP-UCB objective for the LDM method."
      }
    ],
    "diagnostic": [
      {
        "name": "desired_yield",
        "direction": "maximize",
        "description": "Raw desired Chan-Lam product yield retained in evaluation metadata."
      },
      {
        "name": "replicate_scores",
        "direction": "maximize",
        "description": "Per-replicate Chan-Lam weighted selectivity scores."
      },
      {
        "name": "undesired_yield",
        "direction": "minimize",
        "description": "Raw undesired Chan-Lam product yield retained in evaluation metadata."
      }
    ]
  },
  "evaluation": {
    "datasets": [
      "alkylation_deprotection",
      "amide_coupling_hte",
      "buchwald_hartwig",
      "chan_lam_full",
      "reductive_amination",
      "suzuki_cernak",
      "suzuki_doyle"
    ],
    "settings": {
      "oracle": "source-pinned Olympus reaction tables",
      "paper_v2_suite": "six datasets used by the published paper figures",
      "public_union_suite": "paper_v2 plus N-Alkylation / Deprotection",
      "proposal_contract": "direct sampling uses one strict candidate JSON object per independent Chat Completions request; harness sampling uses four persistent task-local research sessions, structured source-pinned space tools, and complete validated minibatches",
      "proposal_sampling": "direct LDM uses 64 independent one-candidate requests; harness LDM uses four concurrent persistent sessions with 16 candidates each, rejects historical and within-session repeats before commit, preserves cross-session occurrences, and then estimates empirical q0",
      "method": "empirical-q0 LDM proposal distribution, q0-weighted maintenance of a configurable BO pool, regularized factor-aware categorical ARD GP-UCB scoring with constant beta, and acquisition-tilted sampling",
      "method_providers": {
        "ldm": "model_endpoint",
        "harness": "persistent_agent_harness",
        "llm": "model_endpoint",
        "bo": "dataset_or_deterministic_search"
      }
    },
    "per_candidate_limits": {
      "benchmark_jobs": 1
    }
  },
