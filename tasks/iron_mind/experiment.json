  "metrics": {
    "reported": [
      {
        "name": "reaction_score",
        "direction": "maximize",
        "description": "Official frozen-table score: raw yield/conversion, or the Chan-Lam lower-bound weighted selectivity score."
      }
    ],
    "optimized": [
      {
        "name": "reaction_score",
        "direction": "maximize",
        "description": "The sole factor-aware categorical ARD GP-UCB objective for the LDM method."
      }
    ],
    "diagnostic": [
      {
        "name": "desired_yield",
        "direction": "maximize",
        "description": "Raw desired Chan-Lam product yield retained in evaluation metadata."
      },
      {
        "name": "replicate_scores",
        "direction": "maximize",
        "description": "Per-replicate Chan-Lam weighted selectivity scores."
      },
      {
        "name": "undesired_yield",
        "direction": "minimize",
        "description": "Raw undesired Chan-Lam product yield retained in evaluation metadata."
      }
    ]
  },
  "evaluation": {
    "datasets": [
      "alkylation_deprotection",
      "amide_coupling_hte",
      "buchwald_hartwig",
      "chan_lam_full",
      "reductive_amination",
      "suzuki_cernak",
      "suzuki_doyle"
    ],
    "settings": {
      "oracle": "source-pinned Olympus reaction tables",
      "paper_v2_suite": "six datasets used by the published paper figures",
      "public_union_suite": "paper_v2 plus N-Alkylation / Deprotection",
      "proposal_contract": "one strict candidate JSON object per independently issued OpenAI-compatible request; the portfolio prompt assigns each request a distinct factor focus, and the shared reservoir validates source membership and removes duplicates",
      "proposal_sampling": "64 independent one-candidate requests by default; portfolio_v1 uses deterministic focus allocations plus task-specific roles, and the local worker limit defaults to 64 without refill requests",
      "method": "empirical-q0 LDM proposal distribution, q0-weighted maintenance of a configurable BO pool, regularized factor-aware categorical ARD GP-UCB scoring with constant beta, and acquisition-tilted sampling",
      "method_providers": {
        "ldm": "model_endpoint",
        "llm": "model_endpoint",
        "bo": "dataset_or_deterministic_search"
      }
    },
    "per_candidate_limits": {
      "benchmark_jobs": 1
    }
  },
