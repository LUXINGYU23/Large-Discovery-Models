{
  "name": "ldm-pi-harness-sidecar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "smoke:capabilities": "npm run build && node dist/capability-smoke.js",
